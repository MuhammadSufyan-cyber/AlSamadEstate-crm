# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only (used to create consultant logins). Keep this secret: never paste it in chat,
# never commit it. Add it in Vercel > Settings > Environment Variables as well.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
